  "faq_title": {
    "message": "Base64Coder Guide",
    "description": "FAQ page heading"
  },
  "faq_section1_title": {
    "message": "How to use the extension in the search bar",
    "description": "FAQ accordion section 1 title"
  },
  "faq_section1_p1": {
    "message": "To activate the extension, enter '64' in the search bar and press 'Tab'.",
    "description": "FAQ section 1 paragraph 1"
  },
  "faq_section1_p2": {
    "message": "Write or paste text that you want to convert and choose the conversion direction: 'base64 - text' or 'text - base64' using keyboard or mouse.",
    "description": "FAQ section 1 paragraph 2"
  },
  "faq_section2_title": {
    "message": "Context menu features",
    "description": "FAQ accordion section 2 title"
  },
  "faq_section2_p1": {
    "message": "The context menu provides access to the following extension features:",
    "description": "FAQ section 2 intro"
  },
  "faq_section2_li1": {
    "message": "copy base64 -> text - converts the selected text from base64 to text.",
    "description": "FAQ section 2 list item 1"
  },
  "faq_section2_li2": {
    "message": "copy text -> base64 - converts the selected text to base64.",
    "description": "FAQ section 2 list item 2"
  },
  "faq_section2_li3": {
    "message": "copy image -> base64 - converts and copy the image under the pointer to base64. Process of converting images to base64 can take some time, you can see the progress in the extension icon.",
    "description": "FAQ section 2 list item 3"
  },
  "faq_section2_li3_progress": {
    "message": "the process is running.",
    "description": "FAQ: progress status running"
  },
  "faq_section2_li3_done": {
    "message": "the process is done.",
    "description": "FAQ: progress status done"
  },
  "faq_section2_li3_error": {
    "message": "an error occurred during the process.",
    "description": "FAQ: progress status error"
  },
  "faq_section2_li4": {
    "message": "open base64 - opens the selected text in the extension where you can covert it to what you need.",
    "description": "FAQ section 2 list item 4"
  },
  "faq_section3_title": {
    "message": "Available hot keys",
    "description": "FAQ accordion section 3 title"
  },
  "faq_section3_p1": {
    "message": "The extension provides the following keyboard shortcuts:",
    "description": "FAQ section 3 intro"
  },
  "faq_section3_li1": {
    "message": "Ctrl + S - saves the result to the file. (Video is not supported)",
    "description": "FAQ section 3 list item 1"
  },
  "faq_section3_li2": {
    "message": "Ctrl + Shift + S - saves the result to the file without base64 mime prefix. (Video is not supported)",
    "description": "FAQ section 3 list item 2"
  },
  "faq_section3_li3": {
    "message": "Shift - buttons \"Copy\" and \"Save\" will do their function removing base64 mime prefix. The \"Clear\" buttons simultaneously clear the source and the result.",
    "description": "FAQ section 3 list item 3"
  },
  "faq_section3_li4": {
    "message": "Shift + Backspace or Shift + Delete - clears the source and the result.",
    "description": "FAQ section 3 list item 4"
  },
  "faq_section3_li5": {
    "message": "Alt + Number - activates the corresponding button in the action area.",
    "description": "FAQ section 3 list item 5"
  },
  "faq_section3_li6": {
    "message": "Ctrl + C - copies text result to clipboard if nothing is selected. If something is selected, then the combination works as usual.",
    "description": "FAQ section 3 list item 6"
  },
  "faq_section3_li7": {
    "message": "Ctrl + Shift + C - copies text result to clipboard without mime type prefix if nothing is selected. If something is selected, then the combination works as usual.",
    "description": "FAQ section 3 list item 7"
  },
  "faq_section3_li8": {
    "message": "Ctrl + O - opens the file in the extension.",
    "description": "FAQ section 3 list item 8"
  },
  "faq_section4_title": {
    "message": "Result formatting",
    "description": "FAQ accordion section 4 title"
  },
  "faq_section4_p1": {
    "message": "If the result is JSON, you can use the \"Pretty\" button, which formats the JSON. If JSON contains properties such as \"iat\", \"exp\" (which usually exist in JWT), the extension allows you to view the date/time in a human-readable format.",
    "description": "FAQ section 4 paragraph 1"
  },
  "faq_section5_title": {
    "message": "What to do if something goes wrong?",
    "description": "FAQ accordion section 5 title"
  },
  "faq_section5_p1": {
    "message": "Try turning it off and then turning it back on.",
    "description": "FAQ section 5 paragraph 1"
  },
  "faq_section5_p2": {
    "message": "If this doesn't help, write to me. Maybe I can help.",
    "description": "FAQ section 5 paragraph 2"
  },
  "faq_section5_email": {
    "message": "E-mail:",
    "description": "FAQ section 5 email label"
  },

